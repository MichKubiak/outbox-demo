<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="OUTBOX_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [%X{correlationId:-}] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${OUTBOX_LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <logger name="com.example.outbox" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
